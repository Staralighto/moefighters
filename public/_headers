# Vite hashes these. The name changes when the bytes change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Same URL across deploys. A day in the browser cache, then a week of stale-while-revalidate,
# so a return visit does not wait on a revalidation round trip.
/sprites/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/stages/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/fonts/*
  Cache-Control: public, max-age=2592000

# Stable URLs. The music file is the largest request on the site, so a return visit
# must not revalidate it across a slow link.
/bgm/*
  Cache-Control: public, max-age=2592000

/sfx/*
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=86400

/favicon.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400
