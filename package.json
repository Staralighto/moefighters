{
  "name": "moefighters",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node --experimental-strip-types scripts/compress-images.ts && node --experimental-strip-types scripts/asset-manifest.ts",
    "preview": "vite preview",
    "check": "node --experimental-strip-types scripts/selfcheck.ts",
    "check:adaptation": "node scripts/adaptation-e2e.mjs",
    "sprite:align": "node --experimental-strip-types scripts/repack-common.ts",
    "sheets": "node --experimental-strip-types scripts/write-sheets.ts",
    "portraits": "node --experimental-strip-types scripts/portraits.ts",
    "story": "node --no-warnings --experimental-strip-types scripts/story.ts"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
